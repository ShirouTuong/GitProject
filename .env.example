# Node.js Application
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# PostgreSQL Database Configuration
DB_HOST=db
DB_PORT=5432
DB_NAME=project_db
DB_USER=pm_admin
DB_PASSWORD=ChangeThisPasswordInEnvFile!2026

# Database Management Tools (Adminer & pgAdmin)
ADMINER_PORT=8080
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@tuong.ictu.vn
PGADMIN_PASSWORD=ChangeThisPasswordInEnvFile!2026

# Nginx Ports
HTTP_PORT=80
HTTPS_PORT=443

# Monitoring Ports
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100

# Grafana Credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=ChangeGrafanaPasswordInEnv!
